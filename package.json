{
  "name": "workday-mcp-schema",
  "version": "0.1.0",
  "description": "Permission-safe Workday MCP server: task-shaped tools, per-user OAuth, preview-then-confirm writes.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "workday-mcp-schema": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check:rbac": "tsx scripts/check-rbac.ts",
    "sync:agent-ready": "tsx scripts/sync-agent-ready-catalog.ts",
    "check:integrations": "tsx scripts/check-integrations.ts",
    "serve": "node dist/server/main.js",
    "dev:serve": "tsx src/server/main.ts",
    "admin": "node dist/cli/admin.js",
    "db:migrate": "node dist/cli/admin.js migrate",
    "check:durable": "tsx scripts/check-durable.ts",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "check:security": "tsx scripts/check-security.ts",
    "check": "pnpm run typecheck && pnpm run check:rbac && pnpm run check:mcp && pnpm run check:integrations && pnpm run check:migrations && pnpm run check:durable && pnpm run check:security && tsx scripts/check-ci-template.ts",
    "db:status": "node dist/cli/admin.js db-status",
    "db:seed:dev": "node dist/cli/admin.js seed-dev",
    "db:export": "tsx scripts/export-sql.ts",
    "check:migrations": "tsx scripts/check-migrations.ts && tsx scripts/export-sql.ts --check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "workday",
    "oauth",
    "hcm"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.91",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.163",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
