CREATE TABLE IF NOT EXISTS schema_migrations (
  version int PRIMARY KEY,
  name text NOT NULL,
  applied_at timestamptz NOT NULL DEFAULT now(),
  checksum text
);
ALTER TABLE schema_migrations ADD COLUMN IF NOT EXISTS checksum text;
DO $chk$ BEGIN IF EXISTS (SELECT 1 FROM schema_migrations WHERE version > 2) THEN RAISE EXCEPTION 'database has migrations newer than these files (latest 2); never downgrade'; END IF; END $chk$;
