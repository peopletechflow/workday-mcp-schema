# Sandbox / implementation tenant only by default.
# Production requires WORKDAY_ALLOW_PROD=true (explicit opt-in).

WORKDAY_BASE_URL=https://wd2-impl-services1.workday.com
WORKDAY_TENANT=your_sandbox_tenant

# OAuth 2.0 API client registered in Workday (authorization code + PKCE).
# Never commit real secrets. Prefer a secrets manager in real deployments.
WORKDAY_OAUTH_CLIENT_ID=your_client_id
WORKDAY_OAUTH_CLIENT_SECRET=your_client_secret
WORKDAY_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
WORKDAY_OAUTH_AUTHORIZE_URL=https://wd2-impl.workday.com/your_sandbox_tenant/authorize
WORKDAY_OAUTH_TOKEN_URL=https://wd2-impl-services1.workday.com/ccx/oauth2/your_sandbox_tenant/token
WORKDAY_OAUTH_SCOPES=openid

# Optional: path for encrypted per-user refresh tokens (default: .data/tokens.json)
# WORKDAY_TOKEN_STORE_PATH=.data/tokens.json

# Optional: append-only audit log path (default: .data/audit.jsonl)
# WORKDAY_AUDIT_LOG_PATH=.data/audit.jsonl

# Must remain false (or unset) unless you intentionally target production.
WORKDAY_ALLOW_PROD=false

# Optional: kill switches (comma-separated tool names)
# WORKDAY_DISABLED_TOOLS=

# Dev: use in-memory fixture client instead of live HTTP
WORKDAY_USE_FIXTURES=true
