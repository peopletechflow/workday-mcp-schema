# Sandbox / implementation tenant only by default.
# Production requires WORKDAY_ALLOW_PROD=true (explicit opt-in).

WORKDAY_BASE_URL=https://wd2-impl-services1.workday.com
WORKDAY_TENANT=your_sandbox_tenant

# OAuth 2.0 API client registered in Workday (authorization code + PKCE).
# Never commit real secrets. Prefer a secrets manager in real deployments.
WORKDAY_OAUTH_CLIENT_ID=your_client_id
WORKDAY_OAUTH_CLIENT_SECRET=your_client_secret
WORKDAY_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
WORKDAY_OAUTH_AUTHORIZE_URL=https://wd2-impl.workday.com/your_sandbox_tenant/authorize
WORKDAY_OAUTH_TOKEN_URL=https://wd2-impl-services1.workday.com/ccx/oauth2/your_sandbox_tenant/token
WORKDAY_OAUTH_SCOPES=openid

# Optional: path for encrypted per-user refresh tokens (default: .data/tokens.json)
# WORKDAY_TOKEN_STORE_PATH=.data/tokens.json
# Required when WORKDAY_USE_FIXTURES=false (stdio server): at least 32 characters, no fallback.
# The stdio server then serves WORKDAY_OAUTH_REDIRECT_URI on loopback to complete sign-in.
# WORKDAY_TOKEN_ENCRYPTION_KEY=

# Optional: append-only audit log path (default: .data/audit.jsonl)
# WORKDAY_AUDIT_LOG_PATH=.data/audit.jsonl

# Must remain false (or unset) unless you intentionally target production.
WORKDAY_ALLOW_PROD=false

# Optional: kill switches (comma-separated tool names)
# WORKDAY_DISABLED_TOOLS=

# Dev: use in-memory fixture client instead of live HTTP
WORKDAY_USE_FIXTURES=true

# RBAC (fixtures/dev): comma-separated roles for the local user.
# Valid: worker_self, manager, hr_partner, payroll_viewer, admin. Unknown roles fail startup.
# Production: derive roles from the user's Workday security groups instead.
WORKDAY_USER_ROLES=worker_self

# ---- Enterprise Layer-3: user permission assignments + AI SDK ----
# Optional JSON file of per-user grants/denies (see docs/RBAC.md).
# WORKDAY_RBAC_ASSIGNMENTS_PATH=.data/rbac-assignments.json

# Comma-separated permission ids for WORKDAY_USER_ID (format: tool:<toolName>).
# Explicit denies win over roles and grants. Unknown ids fail startup/seed.
# WORKDAY_USER_GRANTS=tool:get_my_time_off_balance
# WORKDAY_USER_DENIES=tool:list_my_pay_statements

# Vercel AI Gateway (all model calls go through src/ai/). Leave unset in CI/fixtures.
# AI_GATEWAY_API_KEY=
# WORKDAY_AI_MODEL=anthropic/claude-sonnet-4.5
# WORKDAY_AI_DISABLED=1

# ---- Slack + Notion integrations (all disabled unless set) ----
# Values are env references; use a secrets manager. Never commit real values.
# SLACK_ENABLED=false
# SLACK_SIGNING_SECRET=
# SLACK_ALLOWED_TEAM_IDS=T0EXAMPLE
# SLACK_ALLOWED_CHANNEL_IDS=C0EXAMPLE
# SLACK_BOT_USER_ID=U0BOTEXAMPLE
# SLACK_COMMAND_NAME=/workday
# SLACK_MAX_BODY_BYTES=65536
# SLACK_MAX_INTAKE_CHARS=4000
# Approval delivery is off unless set to "explicit" and a bot token exists. "explicit" DMs assigned
# approvers (Approve / Reject buttons) and the requester (receipt; Submit button after approval).
# SLACK_APPROVAL_DELIVERY=off
# SLACK_APPROVAL_CHANNEL_ID=   # fallback only, when no assigned approver has an active link
# SLACK_BOT_TOKEN=             # scopes: commands, chat:write, im:write
# APPROVAL_POLICY_PATH=examples/integrations/approval-policy.example.json
# Approver decision deadline and post-approval submit window (ms; 1 min to 14 days).
# APPROVAL_DECISION_TTL_MS=259200000   # 72 h
# APPROVAL_COMMIT_WINDOW_MS=86400000   # 24 h
# NOTION_ENABLED=false
# NOTION_MODE=allowlist   # or delegated (per-user tokens from a server-side store)
# NOTION_RESOURCE_POLICY_PATH=examples/integrations/notion-resources.example.json
# NOTION_SERVICE_TOKEN=   # allowlist mode only, limited to policy resources

# ---- Production integration runtime (npm run serve) ----
# NODE_ENV=production           # enforces live mode, https redirect, bot token
# PORT=8787
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# DB_MIGRATE_ON_START=false     # prefer: npm run db:migrate
# TOKEN_ENCRYPTION_KEY=          # npm run admin -- keygen (32 bytes base64); from a secrets manager
# TOKEN_ENCRYPTION_KEY_ID=
# TOKEN_ENCRYPTION_KEY_PREVIOUS= # rotation only
# TOKEN_ENCRYPTION_KEY_PREVIOUS_ID=
# Production acknowledgement: linking does not yet verify the Workday signer is the invited user.
# See docs/RUNBOOK.md "Account linking identity".
# LINK_ACCEPT_UNVERIFIED_SIGNER=true
# ADMIN_ACTOR=you@example.com    # recorded in admin_audit
# Live Workday (WORKDAY_USE_FIXTURES=false):
# WORKDAY_ABSENCE_API_VERSION=v1 # copy from your tenant REST directory; no default
# WORKDAY_VALIDATED_OPERATIONS=  # timeOffDetails.list,requestTimeOff.create,balances.list after sandbox validation
# WORKDAY_HTTP_TIMEOUT_MS=15000
# WORKDAY_TIME_OFF_TYPE_MAP={"vacation":{"type":"Time_Off_Type_ID","value":"<id from tenant>"}}
# WORKDAY_OAUTH_REDIRECT_URI=https://<host>/oauth/callback
